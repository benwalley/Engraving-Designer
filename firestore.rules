rules_version = '2';

// Paste into Firebase console → Firestore Database → Rules.
// Snapshots can be created and fetched by ID, but never listed, edited, or deleted.
service cloud.firestore {
  match /databases/{database}/documents {
    match /snapshots/{snapshotId} {
      allow get: if true;
      allow create: if request.resource.data.keys().hasOnly(
                         ['canvasData', 'thumbnailDataUrl', 'modelId', 'versionName', 'createdAt'])
                    && request.resource.data.canvasData is string
                    && request.resource.data.createdAt == request.time;
      allow list, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
